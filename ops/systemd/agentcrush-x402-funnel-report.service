[Unit]
Description=AgentCrush x402 funnel report — daily quote-requests vs conversions to Kris (Telegram, PRIVATE)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/agentcrush
EnvironmentFile=/opt/agentcrush/fetchers/.env
EnvironmentFile=-/opt/agentcrush/scanner/.env
ExecStart=/usr/bin/node /opt/agentcrush/runtime/x402-funnel-report-worker.mjs
StandardOutput=append:/var/log/agentcrush/x402-funnel-report.log
StandardError=append:/var/log/agentcrush/x402-funnel-report.log
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
