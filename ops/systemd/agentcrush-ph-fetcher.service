[Unit]
Description=ph-fetcher (Layer 1) — pull recent Product Hunt launches matching AI/agent keywords/topics
Documentation=https://github.com/kristof-sudo/agentcrush-app/blob/main/runtime/ph-fetcher.mjs
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/agentcrush
EnvironmentFile=/opt/agentcrush/fetchers/.env
ExecStartPre=/bin/bash -lc 'cd ${BRAIN_PATH:-/opt/agentcrush-brain} && git pull --rebase --quiet origin main 2>/dev/null || true'
ExecStart=/usr/bin/node /opt/agentcrush/runtime/ph-fetcher.mjs
StandardOutput=append:/var/log/agentcrush/ph-fetcher.log
StandardError=append:/var/log/agentcrush/ph-fetcher.log
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
