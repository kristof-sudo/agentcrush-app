[Unit]
Description=AgentCrush snapshot anchor — verifiable historic record (daily Merkle root + chain)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/agentcrush
EnvironmentFile=/opt/agentcrush/fetchers/.env
EnvironmentFile=-/opt/agentcrush/scanner/.env
# --anchor-onchain enables the on-chain Base write; it is additionally gated by
# ANCHOR_ENABLED=1 in the env, so the flag is safe to keep on by default.
# (2026-06-29: CDP wallet rotated to v2 + funded; anchoring is LIVE.)
ExecStart=/usr/bin/node /opt/agentcrush/runtime/snapshot-anchor-worker.mjs --write --anchor-onchain
StandardOutput=append:/var/log/agentcrush/snapshot-anchor.log
StandardError=append:/var/log/agentcrush/snapshot-anchor.log
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
