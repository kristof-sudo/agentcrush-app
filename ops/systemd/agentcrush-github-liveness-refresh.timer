[Unit]
Description=AgentCrush GitHub liveness refresh timer — 03:00 UTC daily
Documentation=Populates agents.github_pushed_at/github_stars_live for the Ghost Check + Ghost Index

[Timer]
OnCalendar=*-*-* 03:00:00 UTC
Persistent=true
Unit=agentcrush-github-liveness-refresh.service

[Install]
WantedBy=timers.target
