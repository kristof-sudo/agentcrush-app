[Unit]
Description=AgentCrush mid-morning executor — dispatches morning-card approved actions
Documentation=https://github.com/kristof-sudo/agentcrush-app/tree/main/runtime/decision-card
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/agentcrush/runtime/decision-card
EnvironmentFile=/opt/agentcrush/fetchers/.env
ExecStart=/usr/bin/node /opt/agentcrush/runtime/decision-card/scheduled-executor.mjs morning
StandardOutput=append:/var/log/agentcrush/executor-morning.log
StandardError=append:/var/log/agentcrush/executor-morning.log
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
