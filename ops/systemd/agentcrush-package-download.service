[Unit]
Description=AgentCrush package download signal worker
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/agentcrush/scanner
ExecStart=/usr/bin/flock --nonblock /run/agentcrush-package-download.lock \
    /usr/bin/node /opt/agentcrush/scanner/signals/package-download-worker.mjs \
    --write --limit 50 --window weekly
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agentcrush-package-download
