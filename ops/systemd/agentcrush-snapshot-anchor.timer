[Unit]
Description=AgentCrush snapshot anchor timer — daily 04:30 UTC (after record-daily-snapshot)
Documentation=Computes + stores the day's Merkle root/chain in snapshot_anchors. Requires migration 20260619_1400_snapshot_anchors.sql. On-chain Base anchoring is opt-in (ANCHOR_ENABLED=1).

[Timer]
OnCalendar=*-*-* 04:30:00 UTC
Persistent=true
Unit=agentcrush-snapshot-anchor.service

[Install]
WantedBy=timers.target
