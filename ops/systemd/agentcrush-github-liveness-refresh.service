[Unit]
Description=AgentCrush GitHub liveness refresh — store real pushed_at + stars on agents
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/agentcrush
EnvironmentFile=/opt/agentcrush/fetchers/.env
EnvironmentFile=-/opt/agentcrush/scanner/.env
ExecStart=/usr/bin/node /opt/agentcrush/runtime/github-liveness-refresh.mjs --write
StandardOutput=append:/var/log/agentcrush/github-liveness-refresh.log
StandardError=append:/var/log/agentcrush/github-liveness-refresh.log
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
