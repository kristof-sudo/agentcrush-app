{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(cd /Users/pk/projects/agentcrush-brain *)"
    ]
  },
  "skipDangerousModePermissionPrompt": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/pk/projects/agentcrush-app/.claude/hooks/log-session-start.sh >> /tmp/agentcrush-brain-autocommit.log 2>&1"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/pk/projects/agentcrush-app/.claude/hooks/log-session-end.sh >> /tmp/agentcrush-brain-autocommit.log 2>&1"
          }
        ]
      }
    ]
  }
}
