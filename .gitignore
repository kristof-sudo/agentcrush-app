# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# CDP wallet output (contains account address — keep off git)
cdp-server-wallet-account.json
cdp-buyer-wallet-account.json

# AgentCrush runtime local state
runtime/**/.env
runtime/**/node_modules/
runtime/**/approval_listener_offset.json
runtime/**/telegram_offset.txt
runtime/**/watchlist-user-cache.json
runtime/state/

# Local ops logs
ops/logs/
.env*.local
.claude/worktrees/
runtime/brain-mcp/node_modules/
runtime/mobile-qa/node_modules/
.claude/settings.local.json
